# Salin file ini menjadi .env lalu isi nilai aslinya.
# Jangan pernah commit file .env ke GitHub.
FLASK_ENV=production
SECRET_KEY=ganti_dengan_nilai_acak_panjang
APP_PORT=5000

# Gunakan hostname atau variabel, jangan tulis IP langsung di kode
DB_HOST=isi_host_atau_ip_db
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=isi_user
DB_PASSWORD=isi_password

# Backup & rclone
RCLONE_REMOTE=gdrive
BACKUP_DIR=/home/pbl-db/backups

# TheHive (isi nanti saat setup soc-ir)
THEHIVE_SECRET=
THEHIVE_DB_PASSWORD=

# MISP (isi nanti saat setup soc-ir)
MISP_ADMIN_EMAIL=
MISP_ADMIN_PASSWORD=
MISP_MYSQL_PASSWORD=

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_SENDER=