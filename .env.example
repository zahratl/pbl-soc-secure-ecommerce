# Salin file ini menjadi .env lalu isi nilai aslinya.
# Jangan pernah commit file .env ke GitHub.
FLASK_ENV=production
SECRET_KEY=ganti_dengan_nilai_acak_panjang
APP_PORT=5000

# Gunakan hostname atau variabel, jangan tulis IP langsung di kode
DB_HOST=isi_host_atau_ip_db
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=isi_user
DB_PASSWORD=isi_password
